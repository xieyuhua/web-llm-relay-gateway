// ========== 粘贴到控制台回车 ==========
(function () {
    // 先移除之前绑定的（防止重复跑多次）
    if (window.__clickSelectorLogger__) {
        document.removeEventListener('click', window.__clickSelectorLogger__, true);
    }

    window.__clickSelectorLogger__ = function (e) {
        e.preventDefault();   // 阻止跳转/提交，方便你看结果
        e.stopPropagation();  // 阻止冒泡

        const el = e.target;
        console.log('%c═══ 你点击了 ═══', 'color: #4CAF50; font-weight: bold; font-size: 14px');
        console.log('标签:', el.tagName);
        console.log('文本:', el.innerText?.slice(0, 30) || '(无)');
        console.log('HTML:', el.outerHTML?.slice(0, 120));
        console.log('Selector:', getCssSelector(el));
        console.log('%c──────────────', 'color: #999');

        // 高亮一下
        el.style.outline = '3px solid #ff4400';
        setTimeout(() => el.style.outline = '', 2000);
    };

    // 捕获阶段执行 = 在 click 真正触发前就拦住
    document.addEventListener('click', window.__clickSelectorLogger__, true);

    console.log('%c✅ 点击监听已开启！去页面上点任何元素试试吧～（再跑一次此脚本可关闭）', 'color: #2196F3; font-size: 13px;');
})();

// 生成最短可用 CSS 选择器的函数
function getCssSelector(el) {
    if (!el || el.nodeType !== 1) return '';
    if (el.id) return '#' + el.id;

    // 优先用 data-testid / data-id（最稳）
    if (el.getAttribute('data-testid')) return `[data-testid="${el.getAttribute('data-testid')}"]`;
    if (el.getAttribute('data-id')) return `[data-id="${el.getAttribute('data-id')}"]`;

    // 用 tag + class
    let selector = el.tagName.toLowerCase();
    if (el.className && typeof el.className === 'string') {
        const cls = el.className.trim().split(/\s+/).filter(c => c && !c.includes(':'));
        if (cls.length) selector += '.' + cls.join('.');
    }

    // 加 nth-child 保证唯一
    let nth = 1;
    let sibling = el;
    while (sibling = sibling.previousElementSibling) nth++;
    selector += `:nth-child(${nth})`;

    // 往上拼一层父级，增加可读性
    if (el.parentElement && el.parentElement !== document.body) {
        let parent = el.parentElement;
        let pSelector = parent.tagName.toLowerCase();
        if (parent.className && typeof parent.className === 'string') {
            const pCls = parent.className.trim().split(/\s+/).slice(0, 2).join('.');
            if (pCls) pSelector += '.' + pCls;
        }
        selector = pSelector + ' > ' + selector;
    }
    return selector;
}
